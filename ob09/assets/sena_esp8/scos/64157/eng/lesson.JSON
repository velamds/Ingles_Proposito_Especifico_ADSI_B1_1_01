pe": "text", "content": ""}], "correct_feedback": "Correct!", "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}], "id": 10}, {"stimuli_ids": [], "template_override": 1, "questions": [{"_data": [{"contents": [{"type": "pdf", "content": "enpe8n5le01ob09re7pdf01.pdf"}], "type": "question"}], "responses": [{"_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1, "id": 0}], "id": 0}], "type": "DWS", "_data": [{"contents": [{"type": "text", "content": " Catching up with Enterprise Architecture"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}], "id": 11}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"_data": [], "title": "", "type": "audio", "template_override": 1, "id": 1, "contents": [{"value": {"audiosrc": "enpe8n5le01ob09re2aud01", "images": [{"time": "100", "image": "enpe8n5le01ob09re2img01.jpg", "id": 0, "text": "Every time I say I'm a software architect people imagine I'm some kind of hermit that lives in a basement programming and coding applications, but they are wrong. To be a software architect, you don't really need to have the slightest clue about coding or programming. What you really need to know about is business management. To become a software architect, you will need to know how a business model is structured, understand the kind of data the company is working with, and how a company manages information. <br/>\nI am going to give you a brief explanation of enterprise architecture.  When we talk about enterprise architecture, we refer to distinct domains that intend to reduce the complexity of the data in a company."}, {"time": "44000", "image": "enpe8n5le01ob09re2img02.jpg", "id": 1, "text": "Now, I'll mention the four types of enterprise architecture. First, we have business architecture, which is the most important one, as it sorts out and defines the governance and strategies of any business. Second, we have Information architecture where we find all the logical and physical data a company works with. After that, we have the application architecture, where all the individual applications to process data are developed. It serves as a blueprint for future software. Finally, the information technology architecture, which is the most dynamic of all architectures, defines all the software and hardware the company requires to build a robust information system."}, {"time": "87000", "image": "enpe8n5le01ob09re2img03.jpg", "id": 2, "text": "If you ask me, I would say that business architecture is the most suitable of all of them to help a company meet its goals. On the other hand, application architecture is the most interactive in terms of design. Now, in terms of organization, I would say that data architecture has to be the most organized and accessed of the four categories. Finally, technical architecture is the one that requires the most support."}], "coverimg": "enpe8n5le01ob09re2img01.jpg"}, "type": "slideshow"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0}]}